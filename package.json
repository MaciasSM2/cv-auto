{
  "name": "cv-auto",
  "version": "1.0.0",
  "description": "Sistema automatizado de auditoría, optimización y generación de hojas de vida con IA para normas ATS 2026",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=backend && npm run build --workspace=frontend",
    "graphify": "graphify",
    "caveman": "caveman"
  },
  "devDependencies": {
    "@caveman-ai/cli": "^2.0.1",
    "@sentropic/graphify": "^0.19.1",
    "concurrently": "^9.1.2"
  },
  "keywords": [
    "resume",
    "cv",
    "ats",
    "ai",
    "pdf-generator",
    "job-search",
    "linkedin"
  ],
  "author": "Sebastian Macias",
  "license": "ISC"
}
